# ==============================================================================
# AI AGE PREDICTION HUB - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. PostgreSQL Database URL (Connection string from Supabase, Neon, Railway, or AWS RDS)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 2. NextAuth Secret for JWT session signing and token encryption (Generated 32-byte hex string)
# You can generate a new one with: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="f6c8d7e9b0a1f2e3d4c5b6a7890123456789abcdef0123456789abcdef012345"

# 3. Canonical URL of the deployment for NextAuth callbacks (e.g., https://your-hub.vercel.app in production)
NEXTAUTH_URL="https://your-app.vercel.app"

# 4. Email Provider Selector ("gmail" or "resend")
EMAIL_PROVIDER="gmail"

# --- Option A: GMAIL SMTP Configuration (Can send to ANY email without custom domain) ---
# GMAIL_USER: Your full Gmail address
GMAIL_USER="youraddress@gmail.com"
# GMAIL_APP_PASSWORD: 16-character Google App Password (NOT your regular Gmail password)
# How to generate: Google Account -> Security -> 2-Step Verification -> App Passwords -> Create "Age Hub"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# --- Option B: RESEND API Configuration (Requires custom domain to send outside account owner) ---
# Resend API Key for transactional emails (Get from https://resend.com/api-keys)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
# Verified sender email address (Default dev: onboarding@resend.dev; Production: e.g. auth@yourcustomdomain.com)
EMAIL_FROM="AI Age Prediction Hub <onboarding@resend.dev>"

# 5. Public application base URL used to construct verification email links
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
